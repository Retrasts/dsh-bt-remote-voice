    {
      "name": "dsh-bt-remote-voice",
      "title": {
        "zh": "蓝牙遥控器语音输入",
        "en": "Bluetooth Remote Voice"
      },
      "description": {
        "zh": "按住蓝牙语音遥控器的语音键说话，松手后语音直接变成文字进入输入框。语音取自遥控器自己的麦克风（BLE ATVV + IMA ADPCM），不需要电脑麦克风。需要先在 /etc/bluetooth/main.conf 设置 DisablePlugins = input。",
        "en": "Hold the voice key on a BLE voice remote, speak, release — the audio captured by the remote's own microphone (ATVV + IMA ADPCM) becomes text. No host microphone required. Requires DisablePlugins = input in /etc/bluetooth/main.conf."
      },
